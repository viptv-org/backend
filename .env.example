# Copy to .env and chmod 600 .env.
# Every protected request uses a revocable account or paired-device session.

# Required exact public HTTPS dashboard origin for browser Origin/CSRF validation.
# Replace this value for another deployment; do not add a path or trailing slash.
VIPTV_AUTH_ORIGIN=https://viptv.syek.tech

# Host publishing address, NOT the address entered on Roku.
# 0.0.0.0 publishes on all host interfaces; firewall to trusted LAN clients.
# Prefer your host's LAN IP here if it has multiple interfaces.
# 127.0.0.1 is browser-on-server-only and prevents direct Roku access.
VIPTV_PUBLISH_IP=0.0.0.0
VIPTV_PORT=8080

# Session/provider limits protect upstream subscription allowances; FFmpeg itself has
# no container CPU/memory/swap/PID quota and may use all resources available on the host.
VIPTV_MAX_SESSIONS=2
# Inactive playback session expiry in seconds (server accepts 30 through 3600).
VIPTV_SESSION_TTL=120

# Optional exact origins allowed to read session media cross-origin.
# Scoped to /media only; never /api. Empty disables cross-origin media reads.
VIPTV_MEDIA_CORS_ORIGINS=https://mediabunny.dev

# Set to 0 to keep all clients on managed HLS; 1 allows verified native candidates.
VIPTV_DIRECT_PLAY=1
