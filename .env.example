# Copy to .env and chmod 600 .env.
# Every protected request uses a revocable account or paired-device session.

# Required exact public HTTPS dashboard origin for browser Origin/CSRF validation.
# Replace this value for another deployment; do not add a path or trailing slash.
VIPTV_AUTH_ORIGIN=https://viptv.syek.tech

# Host publishing address, NOT the address entered on Roku.
# 0.0.0.0 publishes on all host interfaces; firewall to trusted LAN clients.
# Prefer your host's LAN IP here if it has multiple interfaces.
# 127.0.0.1 is browser-on-server-only and prevents direct Roku access.
VIPTV_PUBLISH_IP=0.0.0.0
VIPTV_PORT=8080

# Media execution, GPU devices and viewer lease settings belong to the separate
# gateway. Backend source/provider configuration uses the authenticated v2 APIs.
# V2 encrypted credential storage. Leave unset until provisioning a real keyring.
# Generate 32 random bytes per key and encode as standard Base64. Keep older keys
# while records still reference them. Never commit the real JSON or key material.
# VIPTV_SECRETS_KEYRING='{"active":"master_2026","keys":{"master_2026":"BASE64_ENCODED_32_BYTE_KEY"}}'

# Optional New Relic OTLP monitoring. Off by default; use an ingest-only key.
# Free-plan operation also requires keeping the vendor account on its free plan.
OBSERVABILITY_ENABLED=false
NEW_RELIC_REGION=US
NEW_RELIC_LICENSE_KEY=
OBSERVABILITY_DAILY_BYTES=10485760
OBSERVABILITY_TRACE_SAMPLE_RATE=0.1
OBSERVABILITY_EXPORT_INTERVAL_SECONDS=30
